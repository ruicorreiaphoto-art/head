    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
